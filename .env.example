# ============================================
# Baza Konkurencyjności Funduszu Sprawiedliwości
# Plik konfiguracyjny zmiennych środowiskowych
# ============================================

# Baza danych PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/baza_konkurencyjnosci?schema=public"

# NextAuth.js
AUTH_SECRET="wygeneruj-klucz-poleceniem-npx-auth-secret"
AUTH_URL="http://localhost:3000"

# Aplikacja
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Baza Konkurencyjności Funduszu Sprawiedliwości"

# Upload plików
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000


# Docker database (use a strong password)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=baza_konkurencyjnosci

# SMTP: mail:worker sends the durable outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
CONTACT_EMAIL=
CRON_SECRET=replace-with-a-long-random-secret

# Set true only when the reverse proxy overwrites X-Forwarded-For.
TRUST_PROXY=false
AUTH_TRUST_HOST=true
