// Prisma Schema — Baza Konkurencyjności Funduszu Sprawiedliwości

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  GUEST
  ORGANIZATION
  ADMIN
}

enum OrganizationStatus {
  PENDING
  ACTIVE
  BLOCKED
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  IN_PROGRESS
  RESOLVED
  CANCELLED
  COMPLETED
}

enum OrderType {
  SUPPLIES     // Dostawy
  SERVICES     // Usługi
  CONSTRUCTION // Roboty budowlane
}

// ============================================
// MODELS
// ============================================

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  password       String
  name           String?
  role           UserRole     @default(ORGANIZATION)
  isActive       Boolean      @default(true)
  sessionVersion Int          @default(0)
  passwordResets PasswordReset[]
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  auditLogs      AuditLog[]
  historyEntries AnnouncementHistory[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([email])
  @@index([organizationId])
  @@map("users")
}

model Organization {
  id            String             @id @default(cuid())
  name          String
  nip           String             @unique
  regon         String             @unique
  krs           String?
  address       String
  city          String
  postalCode    String
  voivodeship   String             // Województwo
  email         String
  phone         String
  status        OrganizationStatus @default(PENDING)
  users         User[]
  announcements Announcement[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([nip])
  @@index([status])
  @@map("organizations")
}

model Announcement {
  id               String             @id @default(cuid())
  procedureNumber  String             @unique  // Numer postępowania
  title            String
  orderType        OrderType
  description      String             @db.Text  // Opis przedmiotu zamówienia (HTML)
  conditions       String?            @db.Text  // Warunki udziału (HTML)
  submissionMethod String?            @db.Text  // Sposób składania ofert
  contactPerson    String?
  contactEmail     String?
  contactPhone     String?
  publishedAt      DateTime?                    // Data publikacji
  bidsDeadline     DateTime?                    // Termin składania ofert
  status           AnnouncementStatus @default(DRAFT)
  cancellationReason String?          @db.Text  // Powód unieważnienia
  resolution       String?            @db.Text  // Treść rozstrzygnięcia (HTML)

  // Dane lokalizacji ogłoszenia
  voivodeship      String?                      // Województwo (kopiowane z organizacji lub ustawiane ręcznie)
  location         String?                      // Miejscowość realizacji
  executionTerm    String?                      // Termin realizacji zamówienia

  organizationId   String
  organization     Organization       @relation(fields: [organizationId], references: [id])

  attachments      Attachment[]
  questions        Question[]
  criteria         EvaluationCriteria[]
  history          AnnouncementHistory[]
  result           ProcurementResult?

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([status])
  @@index([organizationId])
  @@index([publishedAt])
  @@index([procedureNumber])
  @@map("announcements")
}

model Attachment {
  id             String       @id @default(cuid())
  fileName       String       @unique
  originalName   String
  mimeType       String
  fileSize       Int          // w bajtach
  filePath       String
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([announcementId])
  @@map("attachments")
}

model Question {
  id             String       @id @default(cuid())
  content        String       @db.Text
  authorName     String?      // Anonimowe lub jawne
  authorEmail    String?
  isPublic       Boolean      @default(true)
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  answers        Answer[]
  createdAt      DateTime     @default(now())

  @@index([announcementId])
  @@map("questions")
}

model Answer {
  id         String   @id @default(cuid())
  content    String   @db.Text
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([questionId])
  @@map("answers")
}

model EvaluationCriteria {
  id             String       @id @default(cuid())
  name           String
  weight         Float        // Waga procentowa (0-100)
  description    String?      @db.Text
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@index([announcementId])
  @@map("evaluation_criteria")
}

model AnnouncementHistory {
  id             String       @id @default(cuid())
  action         String       // np. "Utworzono", "Opublikowano", "Zmieniono opis"
  details        String?      @db.Text
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  createdAt      DateTime     @default(now())

  @@index([announcementId])
  @@index([userId])
  @@map("announcement_history")
}

model ProcurementResult {
  id               String       @id @default(cuid())
  contractorName   String       // Wybrany wykonawca
  contractorNip    String?
  price            Decimal      @db.Decimal(12, 2)
  justification    String       @db.Text  // Uzasadnienie wyboru
  announcementId   String       @unique
  announcement     Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@map("procurement_results")
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String   // Operacja
  entity    String   // Nazwa encji
  entityId  String?  // ID encji
  details   String?  @db.Text
  ipAddress String?
  userAgent String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([entity])
  @@map("audit_logs")
}

model News {
  id          String   @id @default(cuid())
  title       String
  content     String   @db.Text
  excerpt     String?
  isPublished Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished])
  @@map("news")
}

model PasswordReset {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_resets")
}

model EmailOutbox {
  id          String    @id @default(cuid())
  to          String
  subject     String
  text        String    @db.Text
  replyTo     String?
  attempts    Int       @default(0)
  availableAt DateTime  @default(now())
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([sentAt, availableAt])
  @@map("email_outbox")
}

model RateLimit {
  key       String   @id
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
  @@map("rate_limits")
}
